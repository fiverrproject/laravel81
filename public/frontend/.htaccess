<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical homepage (legacy /home URLs)
  RewriteRule ^home/?$ / [R=301,L]

  # Prefer prerendered route folders (e.g. /blog/foo/index.html)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # Serve existing files and directories as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Unknown routes: CSR shell so crawlers do not get homepage HTML with a 200
  RewriteCond %{DOCUMENT_ROOT}/index.original.html -f
  RewriteRule ^ index.original.html [L]

  RewriteRule ^ index.html [L]
</IfModule>
